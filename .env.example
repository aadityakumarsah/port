# Render / Bun server — auto-loaded by Bun at startup
PORT=10000

# Admin: password to unlock /admin, and the session token
ADMIN_PASSWORD=change-me
ADMIN_TOKEN=change-me

# Supabase — server-side (secret service_role key)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key

# Supabase — client-side (inlined into the browser bundle)
BUN_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
BUN_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary — server-side image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
